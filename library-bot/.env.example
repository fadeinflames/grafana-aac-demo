# Токен от @BotFather
BOT_TOKEN=123456:ABC...
# Telegram user id через запятую (узнать: написать боту /id). Пусто = никого не пускать.
ALLOWED_USERS=123456789
# Папка коллекции MyHomeLib: там лежат *.inpx и zip-архивы (fb2-000024-030559.zip ...)
LIBRARY_DIR=/srv/library
# Если в папке несколько .inpx — укажите нужный. Иначе берётся единственный.
# INPX_FILE=flibusta_fb2_local.inpx
# Где хранить поисковый индекс (SQLite)
DB_PATH=/var/lib/library-bot/index.db
# Язык по умолчанию для поиска (пусто = любой), например ru
DEFAULT_LANG=
# Путь к ebook-convert (calibre), если нужна конвертация fb2 -> epub
EBOOK_CONVERT=ebook-convert

# --- ИИ-поиск ---
# Ключ Anthropic. Если задан, каждый поисковый запрос сначала разбирает Claude
# (опечатки, латиница -> кириллица, "что-то про..."). Без ключа бот ищет по тексту как есть.
ANTHROPIC_API_KEY=sk-ant-...
# AI_SEARCH=0            # выключить ИИ-поиск, не убирая ключ
# Модель разбора запроса. По умолчанию claude-opus-5-5; для быстрее/дешевле: claude-haiku-5-5
# AI_MODEL=claude-opus-5-5
# Таймаут (секунды) на ответ API и на чтение книги из хранилища (шара/NAS)
# API_TIMEOUT=20
