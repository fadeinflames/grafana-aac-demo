# ============================================================================
#  Настройки стенда. Скопируйте этот файл в `.env`:   cp .env.example .env
#  (в PowerShell: Copy-Item .env.example .env)
#  Реальный `.env` игнорируется Git'ом — в репозиторий он не попадёт.
#  ВСЕ значения ниже — только для ЛОКАЛЬНОГО стенда. Для чего-то реального
#  придумайте свои пароли и храните их в менеджере секретов / GitHub Secrets.
# ============================================================================

# --- Grafana ---------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin12345

# --- MinIO (S3-хранилище для Terraform state) -------------------------------
# В паролях не используйте символы # $ пробел и кавычки: значения попадают в
# .secrets/terraform.env, который читает make.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
# Имя бакета, в котором Terraform хранит state. Создаётся автоматически.
# ВНИМАНИЕ: имя также прописано в terraform/envs/test/versions.tf (backend "s3"
# не принимает переменных). Меняете здесь — поменяйте и там.
TF_STATE_BUCKET=tfstate
# Официальный образ лежит на quay.io. Если quay.io у вас недоступен — укажите
# другой образ MinIO (например, из внутреннего реестра).
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-04-22T22-12-26Z

# --- Порты на вашем компьютере (слушаем только 127.0.0.1) -------------------
# Если порт занят другой программой — поменяйте число слева и перезапустите.
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
NODE_EXPORTER_PORT=9100
PUSHGATEWAY_PORT=9091
WEBHOOK_PORT=8081
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Только для профиля `ci` (self-hosted GitHub runner) --------------------
# Заполняйте, только если запускаете `docker compose --profile ci up -d`.
# Где взять токен — см. docs/06-ci-setup.md
RUNNER_REPO_URL=https://github.com/OWNER/REPO
RUNNER_TOKEN=
RUNNER_NAME=grafana-aac-stand-runner
RUNNER_LABELS=grafana-aac-stand
